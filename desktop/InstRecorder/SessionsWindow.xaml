<Window x:Class="InstRecorder.SessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="録音一覧" Height="560" Width="620" MinHeight="380" MinWidth="520"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Sunken}" Padding="16,12"
                BorderBrush="{StaticResource DoubleRule}" BorderThickness="0,0,0,4">
            <StackPanel>
                <TextBlock Text="録音一覧" FontWeight="Bold" FontSize="13"/>
                <TextBlock x:Name="TxtWhere" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <StackPanel x:Name="ListHost"/>
                <TextBlock x:Name="TxtEmpty" Style="{StaticResource Sub}" Visibility="Collapsed"
                           Text="まだ何も録っていません。「新しく始める」から始めてください。"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource Sunken}" Padding="16,12"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="フォルダを開く" Style="{StaticResource TopBarButton}" Height="32"
                            Click="BtnFolder_Click"/>
                    <Button Content="閉じる" Style="{StaticResource TopBarButton}" Height="32"
                            Margin="10,0,0,0" Foreground="{StaticResource FgDim}"
                            IsCancel="True" Click="BtnClose_Click"/>
                </StackPanel>
                <Button Content="新しく始める" Style="{StaticResource AccentButton}" Height="32"
                        HorizontalAlignment="Left" Click="BtnNew_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
