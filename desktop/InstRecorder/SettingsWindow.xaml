<Window x:Class="InstRecorder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="詳しい設定" Height="640" Width="820" MinHeight="520" MinWidth="720"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontFamily="Yu Gothic UI, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダ -->
        <Border Grid.Row="0" Background="{StaticResource Sunken}" Padding="16,12"
                BorderBrush="{StaticResource DoubleRule}" BorderThickness="0,0,0,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource TopBarButton}"
                        Content="閉じる" Click="BtnClose_Click" IsCancel="True"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="詳しい設定" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text="分からなければ触らなくて大丈夫です" Margin="12,0,0,0"
                               FontSize="11" Foreground="{StaticResource FgDim}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 左：選ぶところ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>

                    <!-- 音の入り口 -->
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource TopBarButton}"
                                x:Name="BtnRescan" Content="機器を探し直す" Click="BtnRescan_Click"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="音の入り口" FontWeight="Bold" FontSize="12.5"/>
                            <TextBlock Text="input" Margin="8,0,0,0" FontFamily="Consolas"
                                       FontSize="10" Foreground="{StaticResource FgFaint}"/>
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Height="1" Margin="0,0,0,10" Opacity="0.55" Fill="{StaticResource BrassDeep}"/>
                    <StackPanel x:Name="DeviceList"/>
                    <TextBlock x:Name="TxtNoDevice" Style="{StaticResource Sub}" Visibility="Collapsed"
                               Text="使える機器が見つかりませんでした。マイクを挿してから「機器を探し直す」を押してください。"/>

                    <!-- ASIO のときだけ -->
                    <StackPanel x:Name="PnlAsio" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="ASIO のどの入力を使うか" FontWeight="Bold" FontSize="12.5"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="CmbAsioCh" Width="240"
                                      SelectionChanged="CmbAsioCh_SelectionChanged"/>
                            <Button Style="{StaticResource TopBarButton}" Content="ASIO の設定画面"
                                    Margin="8,0,0,0" Click="BtnAsioPanel_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 音の細かさ -->
                    <StackPanel Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="音の細かさ" FontWeight="Bold" FontSize="12.5"/>
                            <TextBlock x:Name="TxtFormatOriginal" Margin="8,0,0,0" FontFamily="Consolas"
                                       FontSize="10" Foreground="{StaticResource FgFaint}"/>
                        </StackPanel>
                        <Rectangle Height="1" Margin="0,0,0,10" Opacity="0.55" Fill="{StaticResource BrassDeep}"/>
                        <WrapPanel x:Name="FormatChips"/>
                        <TextBlock x:Name="TxtNoFormat" Style="{StaticResource Sub}" Visibility="Collapsed"
                                   Text="この機器では使える細かさが見つかりませんでした。別の機器を選んでください。"/>
                    </StackPanel>

                    <!-- 音の残し方 -->
                    <StackPanel Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="音の残し方" FontWeight="Bold" FontSize="12.5"/>
                            <TextBlock Text="保存するファイルの形" Margin="8,0,0,0" FontSize="10.5"
                                       Foreground="{StaticResource FgFaint}"/>
                        </StackPanel>
                        <Rectangle Height="1" Margin="0,0,0,10" Opacity="0.55" Fill="{StaticResource BrassDeep}"/>
                        <WrapPanel x:Name="SaveChips"/>
                    </StackPanel>

                    <!-- 聞く側 -->
                    <StackPanel x:Name="PnlOutput" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="重ね録りのとき、前の音を鳴らす機器" FontWeight="Bold" FontSize="12.5"/>
                        </StackPanel>
                        <Rectangle Height="1" Margin="0,0,0,10" Opacity="0.55" Fill="{StaticResource BrassDeep}"/>
                        <ComboBox x:Name="CmbOutput" SelectionChanged="CmbOutput_SelectionChanged"/>
                        <TextBlock x:Name="TxtOutputNote" Style="{StaticResource Sub}"
                                   Margin="0,7,0,0"/>
                    </StackPanel>

                    <!-- ズレ合わせ -->
                    <StackPanel Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="重ね録りのズレ合わせ" FontWeight="Bold" FontSize="12.5"/>
                            <TextBlock Text="latency" Margin="8,0,0,0" FontFamily="Consolas"
                                       FontSize="10" Foreground="{StaticResource FgFaint}"/>
                        </StackPanel>
                        <Rectangle Height="1" Margin="0,0,0,10" Opacity="0.55" Fill="{StaticResource BrassDeep}"/>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtLatencyValue" Text="未測定"
                                               FontFamily="Consolas" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource Warn}"/>
                                    <Button x:Name="BtnMeasure" Style="{StaticResource TopBarButton}"
                                            Content="測る" Margin="14,0,0,0" Click="BtnMeasure_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtLatencyNote" Style="{StaticResource Sub}"
                                           Margin="0,8,0,0"
                                           Text="測っておくと、重ねて録った音が前の音とぴったり揃います。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 起動のしかた -->
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="起動のしかた" FontWeight="Bold" FontSize="12.5"
                                   Margin="0,0,0,6"/>
                        <Rectangle Height="1" Margin="0,0,0,10" Opacity="0.55"
                                   Fill="{StaticResource BrassDeep}"/>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel>
                                    <ToggleButton x:Name="TglStartup" DockPanel.Dock="Right"
                                                  Style="{StaticResource Switch}"
                                                  Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                                    <TextBlock Text="開いたらすぐマイクを使う" FontSize="12.5"
                                               Margin="0,0,8,0"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0"
                                           Text="切ると、起動しても音の大きさの目盛りは動きません。他のアプリとマイクを取り合いたくないときに。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 保存先 -->
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="録った音の置き場所" FontWeight="Bold" FontSize="12.5"
                                   Margin="0,0,0,6"/>
                        <Rectangle Height="1" Margin="0,0,0,10" Opacity="0.55" Fill="{StaticResource BrassDeep}"/>
                        <Border Background="{StaticResource Deep}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="6" Padding="11,9">
                            <TextBlock x:Name="TxtFolder" FontFamily="Consolas" FontSize="11.5"
                                       Foreground="{StaticResource FgDim}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 右：この選択が意味すること -->
            <Border Grid.Column="1" Background="{StaticResource Sunken}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Style="{StaticResource TopBarButton}" Content="録った音のフォルダを開く"
                                HorizontalAlignment="Stretch" Click="BtnOpenFolder_Click"/>
                        <Button x:Name="BtnOpenInput" Style="{StaticResource TopBarButton}"
                                Content="音を聞く準備をする" Margin="0,8,0,0"
                                HorizontalAlignment="Stretch" Click="BtnOpenInput_Click"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="この選択が意味すること" FontWeight="Bold" FontSize="12.5"
                                   Margin="0,0,0,6"/>
                        <Rectangle Height="1" Margin="0,0,0,10" Opacity="0.55" Fill="{StaticResource BrassDeep}"/>
                        <TextBlock x:Name="TxtExplain" FontSize="11.5" LineHeight="19"
                                   Foreground="{StaticResource FgDim}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
