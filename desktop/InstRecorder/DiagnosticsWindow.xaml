<Window x:Class="InstRecorder.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音のチェック" Height="760" Width="620" MinHeight="560" MinWidth="560"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontFamily="Yu Gothic UI, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダ -->
        <Border Grid.Row="0" Background="{StaticResource Sunken}" Padding="16,12"
                BorderBrush="{StaticResource DoubleRule}" BorderThickness="0,0,0,4">
            <StackPanel>
                <TextBlock Text="音のチェック" FontWeight="Bold" FontSize="13"/>
                <TextBlock x:Name="TxtTarget" Style="{StaticResource Sub}" Margin="0,4,0,0"
                           Text="まだ測っていません"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>

                <!-- 測る -->
                <WrapPanel>
                    <Button x:Name="BtnSilence" Style="{StaticResource GhostButton}"
                            Content="静かにして測る（5秒）" Margin="0,0,8,8" Click="BtnSilence_Click"
                            ToolTip="まわりの静けさ（暗騒音）と電源のブーン音を調べます"/>
                    <Button x:Name="BtnPlay" Style="{StaticResource GhostButton}"
                            Content="弾きながら測る（5秒）" Margin="0,0,8,8" Click="BtnPlaying_Click"
                            ToolTip="実際に演奏している間の音を調べます"/>
                    <Button x:Name="BtnProcessing" Style="{StaticResource GhostButton}"
                            Content="Windows が加工していないか調べる" Margin="0,0,8,8"
                            Click="BtnProcessing_Click"
                            ToolTip="静かな間だけ入力が絞られていないかを、音を鳴らして確かめます"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="BtnTrack" Style="{StaticResource GhostButton}"
                            Content="録った音を調べる" Click="BtnTrack_Click"/>
                    <ComboBox x:Name="CmbTrack" Width="190" Margin="8,0,0,0" DisplayMemberPath="Name"/>
                </StackPanel>

                <!-- 結論カード -->
                <Border x:Name="CardVerdict" CornerRadius="2" Padding="14" BorderThickness="1"
                        Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="VerdictMark" Width="22" Height="22" CornerRadius="11"
                                    Background="{StaticResource FgDim}" VerticalAlignment="Top">
                                <TextBlock x:Name="VerdictMarkText" Text="?" FontWeight="Bold"
                                           FontSize="12" Foreground="{StaticResource Ink}"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtVerdictTitle" FontWeight="Bold" FontSize="14"
                                       Margin="10,0,0,0" TextWrapping="Wrap"
                                       Text="まず「静かにして測る」を押してください"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtVerdictBody" FontSize="12.5" LineHeight="22"
                                   Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource FgDim}"
                                   Text="録れている音の素性を数字で出します。耳では分かりにくい雑音や電源のブーン音は、録ってしまうと後から取り除きにくいので、録る前に確かめます。"/>

                        <StackPanel x:Name="PnlSteps" Margin="0,12,0,0"/>

                        <StackPanel x:Name="PnlVerdictButtons" Orientation="Horizontal"
                                    Margin="0,12,0,0" Visibility="Collapsed">
                            <Button x:Name="BtnPrimary" Height="30" Padding="13,0" FontSize="12"
                                    FontWeight="Bold" Click="BtnPrimary_Click"/>
                            <Button x:Name="BtnSecondary" Height="30" Padding="13,0" FontSize="12"
                                    Margin="8,0,0,0" Click="BtnSecondary_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 指標 -->
                <Grid x:Name="StatsGrid" Margin="0,12,0,0"/>

                <!-- これまでに測ったもの -->
                <Border x:Name="CardHistory" Style="{StaticResource CardBorder}" Margin="0,12,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="これまでに測ったもの" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,0,0,6"/>
                        <Rectangle Height="1" Margin="0,0,0,10" Opacity="0.55"
                                   Fill="{StaticResource BrassDeep}"/>
                        <StackPanel x:Name="HistoryList"/>
                        <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0"
                                   Text="機材や置き場所を変えたあと、前より良くなったかを見比べるために残しています。"/>
                    </StackPanel>
                </Border>

                <!-- 周波数の分布 -->
                <Border x:Name="CardSpectrum" Style="{StaticResource CardBorder}" Margin="0,12,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="どの高さの音が入っているか" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="周波数分布（1/3オクターブ）" Style="{StaticResource Faint}"
                                   Margin="0,3,0,0"/>
                        <Grid x:Name="SpectrumHost" Height="74" Margin="0,12,0,0"/>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="低い音 63Hz" FontFamily="Consolas" FontSize="10"
                                       HorizontalAlignment="Left" Foreground="{StaticResource FgFaint}"/>
                            <TextBlock Text="1kHz" FontFamily="Consolas" FontSize="10"
                                       HorizontalAlignment="Center" Foreground="{StaticResource FgFaint}"/>
                            <TextBlock Text="高い音 16kHz" FontFamily="Consolas" FontSize="10"
                                       HorizontalAlignment="Right" Foreground="{StaticResource FgFaint}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
