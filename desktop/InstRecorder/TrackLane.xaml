<UserControl x:Class="InstRecorder.TrackLane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource Lane}" BorderBrush="{StaticResource Line}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：名前と操作 -->
            <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"
                    Padding="11,12">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="TxtName" FontWeight="SemiBold" FontSize="12.5"
                                   TextTrimming="CharacterEllipsis" Cursor="IBeam"
                                   ToolTip="クリックすると名前を変えられます"
                                   MouseLeftButtonUp="TxtName_Click"/>
                        <TextBox x:Name="EdtName" FontSize="12.5" Visibility="Collapsed"
                                 KeyDown="EdtName_KeyDown" LostFocus="EdtName_LostFocus"/>
                    </Grid>

                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="TglMute" Grid.Column="0" Content="消音"
                                      Style="{StaticResource MiniToggle}" Tag="#6E3218"
                                      ToolTip="このトラックだけ鳴らさない"
                                      Checked="Mute_Changed" Unchecked="Mute_Changed"/>
                        <ToggleButton x:Name="TglSolo" Grid.Column="1" Content="単独" Margin="5,0,0,0"
                                      Style="{StaticResource MiniToggle}" Tag="#8A6E1E"
                                      ToolTip="このトラックだけ鳴らす"
                                      Checked="Solo_Changed" Unchecked="Solo_Changed"/>
                        <Button x:Name="BtnVolume" Grid.Column="2" Margin="5,0,0,0" Height="22"
                                Padding="0" FontFamily="Consolas" FontSize="10"
                                Background="{StaticResource MiniFace}"
                                ToolTip="クリックすると音量を変えられます"
                                Click="BtnVolume_Click"/>
                    </Grid>

                    <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=BtnVolume}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="このトラックの音量" FontSize="11"
                                           Foreground="{StaticResource FgDim}" Margin="0,0,0,6"/>
                                <Slider x:Name="SldVolume" Width="170" Minimum="0" Maximum="2"
                                        SmallChange="0.01" LargeChange="0.1"
                                        ValueChanged="SldVolume_Changed"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Border>

            <!-- 右：波形とテイク -->
            <Grid Grid.Column="1" Margin="8,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource Deep}"
                        BorderBrush="{StaticResource WaveLine}" BorderThickness="1"
                        CornerRadius="5" ClipToBounds="True">
                    <Canvas x:Name="WaveCanvas" Background="Transparent"
                            MouseLeftButtonDown="Wave_MouseDown"
                            MouseMove="Wave_MouseMove"
                            MouseLeftButtonUp="Wave_MouseUp"
                            SizeChanged="Wave_SizeChanged"/>
                </Border>

                <Grid Grid.Row="1" Margin="0,7,0,0">
                    <!-- 選択が無いとき：テイクの丸ボタン -->
                    <Grid x:Name="PnlTakes">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="聞かせる録り：" FontSize="10.5"
                                   Foreground="{StaticResource FgDim}" Margin="0,0,6,0"/>
                        <WrapPanel x:Name="TakePills" Grid.Column="1"/>
                        <TextBlock Grid.Column="2" Text="どれも消えません" FontSize="10.5"
                                   Foreground="{StaticResource FgFaint}"/>
                    </Grid>

                    <!-- 選択があるとき：その範囲への操作 -->
                    <StackPanel x:Name="PnlSelection" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="BtnPunch" Content="ここだけ録り直す" Height="24" Padding="10,0"
                                FontSize="10.5" FontWeight="Bold" Foreground="White"
                                Background="{StaticResource Rec}" BorderBrush="{StaticResource Rec}"
                                Click="BtnPunch_Click"/>
                        <Button x:Name="BtnCrop" Content="選んだところを切り出す" Height="24" Padding="10,0"
                                FontSize="10.5" Margin="7,0,0,0" Click="BtnCrop_Click"/>
                        <TextBlock Text="元の音は残ります" FontSize="10.5" Margin="9,0,0,0"
                                   Foreground="{StaticResource FgFaint}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
