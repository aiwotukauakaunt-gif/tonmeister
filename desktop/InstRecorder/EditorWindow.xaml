<Window x:Class="InstRecorder.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="波形を見て直す" Height="700" Width="1000"
        MinHeight="560" MinWidth="820"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontFamily="Yu Gothic UI, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダ -->
        <Border Grid.Row="0" Background="{StaticResource Sunken}" Padding="16,12"
                BorderBrush="{StaticResource DoubleRule}" BorderThickness="0,0,0,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="聞かせる録り" FontSize="11.5" Margin="0,0,8,0"
                               Foreground="{StaticResource FgDim}"/>
                    <ComboBox x:Name="CmbTake" Width="150" Height="28"
                              SelectionChanged="CmbTake_SelectionChanged"/>
                    <TextBlock Text="縦の拡大" FontSize="11.5" Margin="16,0,8,0"
                               Foreground="{StaticResource FgDim}"/>
                    <ComboBox x:Name="CmbVerticalZoom" Width="96" Height="28"
                              SelectionChanged="CmbVerticalZoom_SelectionChanged"
                              ToolTip="小さい音を見やすくします（音そのものは変わりません）"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtTrackName" Text="-" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="TxtTakeInfo" FontSize="11.5" Margin="12,0,0,0"
                               Foreground="{StaticResource FgDim}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 波形 -->
        <Border Grid.Row="1" Background="{StaticResource Deep}" Margin="16,16,16,0"
                BorderBrush="{StaticResource WaveLine}" BorderThickness="1" CornerRadius="6"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Canvas x:Name="WaveCanvas" Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="Wave_MouseDown"
                        MouseMove="Wave_MouseMove"
                        MouseLeftButtonUp="Wave_MouseUp"
                        MouseWheel="Wave_MouseWheel"
                        SizeChanged="Wave_SizeChanged"/>

                <Canvas x:Name="RulerCanvas" Grid.Row="1" Background="{StaticResource Sunken}"
                        ClipToBounds="True"/>

                <ScrollBar x:Name="ScrollH" Grid.Row="2" Orientation="Horizontal" Height="14"
                           Minimum="0" Maximum="1" ViewportSize="1"
                           Scroll="ScrollH_Scroll"/>
            </Grid>
        </Border>

        <!-- 選んだところ・ズーム -->
        <Grid Grid.Row="2" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="SelBadge" CornerRadius="2" Padding="7,2"
                            Background="{StaticResource PrussianLight}" Visibility="Collapsed">
                        <TextBlock x:Name="TxtSelRange" FontFamily="Consolas" FontWeight="Bold"
                                   FontSize="10" Foreground="{StaticResource Bg}"/>
                    </Border>
                    <TextBlock x:Name="TxtSelection" FontSize="12" Margin="0,0,0,0"
                               Text="波形をドラッグして「使いたいところ」を選びます"/>
                </StackPanel>
                <TextBlock x:Name="TxtEditInfo" Style="{StaticResource Sub}" Margin="0,6,0,0"
                           Text="元の録音は書き換えません。結果は新しい録りとして増えます。"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnPlay" Style="{StaticResource TopBarButton}" Content="▶ 聞く"
                        Click="BtnPlay_Click"/>
                <Button x:Name="BtnStop" Style="{StaticResource TopBarButton}" Content="■ やめる"
                        Margin="6,0,16,0" Click="BtnStop_Click" IsEnabled="False"/>
                <TextBlock Text="横の拡大" FontSize="11" Margin="0,0,6,0"
                           Foreground="{StaticResource FgDim}"/>
                <Button x:Name="BtnZoomOut" Style="{StaticResource TopBarButton}" Content="−"
                        Width="30" Padding="0" Click="BtnZoomOut_Click"/>
                <Button x:Name="BtnZoomIn" Style="{StaticResource TopBarButton}" Content="＋"
                        Width="30" Padding="0" Margin="4,0,0,0" Click="BtnZoomIn_Click"/>
                <Button x:Name="BtnZoomFit" Style="{StaticResource TopBarButton}" Content="全体"
                        Margin="6,0,0,0" Click="BtnZoomFit_Click"/>
                <Button x:Name="BtnZoomSel" Style="{StaticResource TopBarButton}" Content="選んだところ"
                        Margin="4,0,0,0" Click="BtnZoomSel_Click"/>
            </StackPanel>
        </Grid>

        <!-- できること -->
        <StackPanel Grid.Row="3" Margin="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" CornerRadius="6"
                        Padding="11" Margin="0,0,5,0">
                    <DockPanel>
                        <Button x:Name="BtnCrop" DockPanel.Dock="Bottom" Content="切り出す"
                                Height="28" FontSize="12" Margin="0,10,0,0"
                                Background="{StaticResource Info}" BorderBrush="{StaticResource Info}"
                                Foreground="White" IsEnabled="False" Click="BtnCrop_Click"/>
                        <StackPanel>
                            <TextBlock Text="選んだところだけ残す" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="長い録音から良い部分を取り出す"
                                       Style="{StaticResource Faint}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" CornerRadius="6"
                        Padding="11" Margin="5,0">
                    <DockPanel>
                        <Button x:Name="BtnPunch" DockPanel.Dock="Bottom" Content="録り直す"
                                Height="28" FontSize="12" Margin="0,10,0,0"
                                Background="{StaticResource Rec}" BorderBrush="{StaticResource Rec}"
                                Foreground="White" IsEnabled="False" Click="BtnPunch_Click"/>
                        <StackPanel>
                            <TextBlock Text="選んだところだけ弾き直す" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="2秒の助走つき。前後は自動でつなぎます"
                                       Style="{StaticResource Faint}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" CornerRadius="6"
                        Padding="11" Margin="5,0,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock Text="あとから直せること" FontWeight="SemiBold" FontSize="12"
                                       DockPanel.Dock="Left"/>
                            <TextBlock x:Name="TxtProcSummary" Style="{StaticResource Faint}"
                                       Margin="8,0,0,0" Foreground="{StaticResource Sel}"/>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,6">
                            <ToggleButton x:Name="ChkHum" DockPanel.Dock="Right"
                                          Style="{StaticResource Switch}"
                                          Checked="Processing_Changed" Unchecked="Processing_Changed"/>
                            <TextBlock Text="電源のブーンという音を消す" FontSize="11.5"
                                       Margin="0,0,8,0"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <ComboBox x:Name="CmbHumFreq" Width="118" Height="26" FontSize="11"
                                      SelectionChanged="Processing_Changed"/>
                            <TextBlock Text="倍音" FontSize="11" Margin="8,0,5,0"
                                       Foreground="{StaticResource FgDim}"/>
                            <ComboBox x:Name="CmbHumHarmonics" Width="52" Height="26" FontSize="11"
                                      SelectionChanged="Processing_Changed"/>
                        </StackPanel>

                        <DockPanel Margin="0,0,0,4">
                            <ToggleButton x:Name="ChkGate" DockPanel.Dock="Right"
                                          Style="{StaticResource Switch}"
                                          Checked="Processing_Changed" Unchecked="Processing_Changed"/>
                            <TextBlock Text="弾いていない間を静かにする" FontSize="11.5"
                                       Margin="0,0,8,0"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SldGate" Width="128" Minimum="-90" Maximum="-20" Value="-60"
                                    VerticalAlignment="Center" ValueChanged="GateSlider_Changed"/>
                            <TextBlock x:Name="TxtGate" Text="-60 dB" FontFamily="Consolas"
                                       FontSize="11" Width="54" TextAlignment="Right"
                                       Foreground="{StaticResource FgDim}"/>
                        </StackPanel>

                        <TextBlock Text="切れば元の音に戻ります。" Style="{StaticResource Faint}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
